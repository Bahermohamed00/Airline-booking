# Database (PostgreSQL running locally — Docker is NOT required)
DATABASE_URL=postgresql://airline:airline@localhost:5432/airline_booking?schema=public
# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset / MFA / email verification
RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h
MFA_ISSUER=AirlineBooking

# Sessions / refresh tokens
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=7

# Payment provider (mock)
PAYMENT_PROVIDER=mock

# Notification provider: 'mock' logs emails to the API console (development default);
# 'smtp' sends real email and REQUIRES all SMTP_* variables below plus MAIL_FROM.
NOTIFICATION_PROVIDER=smtp

# Mail (all required when NOTIFICATION_PROVIDER=smtp)
MAIL_FROM="Airline Booking <Aymananwar4250@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Aymananwar4250@gmail.com
SMTP_PASS=jefc lrqx ysib yvsm
