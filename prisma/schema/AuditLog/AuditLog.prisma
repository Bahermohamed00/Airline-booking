model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorType  String   @map("actor_type") @db.VarChar(50)
  action     String   @db.VarChar(100)
  targetType String   @map("target_type") @db.VarChar(100)
  targetId   String?  @map("target_id") @db.VarChar(255)
  metadata   Json?    @db.JsonB
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  bookingId String? @map("booking_id") @db.Uuid

  @@index([actorType, action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@index([action])
  @@index([actorId])
  @@map("audit_logs")
}
