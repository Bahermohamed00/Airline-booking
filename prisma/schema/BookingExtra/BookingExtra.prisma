model BookingExtra {
  id              String @id @default(uuid()) @db.Uuid
  bookingId       String @map("booking_id") @db.Uuid
  extraServiceId  String @map("extra_service_id") @db.Uuid
  // Optional passenger association (meals, per-passenger services); null =
  // booking-scoped line. SetNull keeps the historical line if the
  // BookingPassenger row is ever removed.
  bookingPassengerId String? @map("booking_passenger_id") @db.Uuid
  quantity        Int    @default(1)
  // Line total (unitPrice × quantity), server-calculated at creation.
  price           Decimal @db.Decimal(12, 2)
  // Immutable snapshots for historical accounting — the live catalog row may
  // change price or be deactivated after the booking was made.
  unitPrice       Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  currency        String  @default("EUR") @db.VarChar(3)
  pricingUnit     ExtraPricingUnit @default(PER_ITEM) @map("pricing_unit")
  category        ExtraServiceCategory @default(BAGGAGE)
  serviceCode     String  @default("") @map("service_code") @db.VarChar(50)
  serviceName     String  @default("") @map("service_name") @db.VarChar(100)

  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraService  ExtraService @relation(fields: [extraServiceId], references: [id], onDelete: Restrict)
  bookingPassenger BookingPassenger? @relation(fields: [bookingPassengerId], references: [id], onDelete: SetNull)

  @@unique([bookingId, extraServiceId, bookingPassengerId])
  @@map("booking_extras")
}
