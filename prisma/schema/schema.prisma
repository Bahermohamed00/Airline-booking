// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // Path is relative to this file's directory (prisma/schema/); it resolves to
  // the exact same location as the original single-file schema: <repo>/node_modules/.prisma/client
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
