model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  firstName      String    @map("first_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  phone          String?   @db.VarChar(50)
  // Nullable at the DB level (legacy rows + admin-created staff may lack one);
  // required at registration via RegisterDto.
  streetAddress  String?   @map("street_address") @db.VarChar(255)
  // Egyptian national ID: 14 digits. Nullable (legacy rows + admin-created staff);
  // required at customer registration via RegisterDto. Unique, owner-only exposure.
  nationalId     String?   @unique @map("national_id") @db.VarChar(14)
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  emailVerified  Boolean   @default(false) @map("email_verified")
  // Email-OTP MFA only (TOTP removed — see migration 20261015_email_otp_mfa):
  // enabled means every login requires an emailed 6-digit code.
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles      UserRole[]
  bookings       Booking[]
  passengers     Passenger[]
  loyaltyAccount LoyaltyAccount?
  notifications  Notification[]
  auditLogs      AuditLog[]
  seatHolds      SeatHold[]
  sessions       Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  mfaEmailTokens          MfaEmailToken[]
  supportTickets          SupportTicket[]        @relation("CustomerTickets")
  assignedTickets         SupportTicket[]        @relation("TicketAssignee")
  supportMessages         SupportMessage[]

  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
  PENDING_VERIFICATION

  @@map("user_status")
}
