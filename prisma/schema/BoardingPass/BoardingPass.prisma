model BoardingPass {
  id           String   @id @default(uuid()) @db.Uuid
  checkInId    String   @unique @map("check_in_id") @db.Uuid
  boardingGroup String  @map("boarding_group") @db.VarChar(10)
  seatNumber   String   @map("seat_number") @db.VarChar(10)
  gate         String?  @db.VarChar(20)
  qrCode       String?  @map("qr_code") @db.Text
  issuedAt     DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@map("boarding_passes")
}
