/**
 * Phase 3.4E — a provider-side refund that NovaAir could NOT match to any
 * local refund row (strong matching only: provider refund id already recorded
 * locally, or provider metadata carrying the local refund id). This is an
 * operational investigation record — never a refund, never a state machine:
 * discovery must never create or re-create money movement. Rows are idempotent
 * per (provider, providerRefundReference); UNMATCHED until the provider refund
 * is reconciled (auto) or a staff member resolves it after investigation.
 */
model OrphanProviderRefund {
  id       String @id @default(uuid()) @db.Uuid
  provider String @db.VarChar(50)
  // Provider-side refund reference (Stripe `re_…`) — the strong unique identity.
  providerRefundReference String @map("provider_refund_reference") @db.VarChar(255)
  // Provider reference of the refunded payment (Stripe `pi_…`).
  paymentProviderReference String @map("payment_provider_reference") @db.VarChar(255)
  amount     Decimal            @db.Decimal(12, 2)
  currency   String             @db.VarChar(3)
  status     OrphanRefundStatus @default(UNMATCHED)
  firstSeenAt DateTime          @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt  DateTime          @map("last_seen_at") @db.Timestamptz(6)
  resolvedAt  DateTime?         @map("resolved_at") @db.Timestamptz(6)
  // Staff identity (user id) when resolved manually; null when auto-resolved.
  resolvedBy     String? @map("resolved_by") @db.VarChar(255)
  resolutionNote String? @map("resolution_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, providerRefundReference])
  @@index([status, firstSeenAt])
  @@map("orphan_provider_refunds")
}

enum OrphanRefundStatus {
  UNMATCHED
  RESOLVED

  @@map("orphan_refund_status")
}
