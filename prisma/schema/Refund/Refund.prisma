model Refund {
  id          String       @id @default(uuid()) @db.Uuid
  paymentId   String       @map("payment_id") @db.Uuid
  bookingId   String       @map("booking_id") @db.Uuid
  amount      Decimal      @db.Decimal(12, 2)
  currency    String       @db.VarChar(3)
  status      RefundStatus @default(PENDING)
  reason      String?      @db.Text
  // Provider-side refund reference (e.g. Stripe `re_…`), persisted once the
  // provider confirms the refund — the reconciliation link for refunds.
  providerReference String? @map("provider_reference") @db.VarChar(255)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  cancellationRequests CancellationRequest[]

  @@index([bookingId])
  @@index([paymentId])
  // Operational/reconciliation access pattern: the every-minute refund sweep
  // and the admin pending-aging filters both query (status, createdAt).
  @@index([status, createdAt])
  @@map("refunds")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED

  @@map("refund_status")
}
