# Database (PostgreSQL running locally — Docker is NOT required)
# Placeholder credentials — matches SETUP.md's `CREATE USER airline WITH PASSWORD 'airline'`.
# Replace with your real local credentials in your own (never committed) .env.
DATABASE_URL=postgresql://airline:airline@localhost:5432/airline_booking?schema=public

# API
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# CORS + WebSocket origin: the Angular app origin allowed to call the API and
# open Socket.IO connections (credentials enabled; never a wildcard).
WEB_ORIGIN=http://localhost:4200

# Auth
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset / MFA / email verification
RESET_TOKEN_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h
MFA_ISSUER=AirlineBooking

# Sessions / refresh tokens
SESSION_TTL_DAYS=30
REFRESH_TOKEN_TTL_DAYS=7

# Payment provider: 'mock' (development default) or 'stripe'
PAYMENT_PROVIDER=mock

# Payment reconciliation sweep (PAYMENT_PROVIDER=stripe only): re-checks the
# PaymentIntent of still-PENDING payments older than this many minutes
# (default 5 — well inside the 15-minute seat-hold window so a recovered
# success can still auto-confirm), at most this many per run (default 25; a
# larger backlog drains over the next runs).
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES=5
PAYMENT_RECONCILIATION_BATCH_SIZE=25

# Refund reconciliation sweep: recovers still-PENDING refunds older than this
# many minutes (default 5) by replaying their persisted provider idempotency
# key — an ambiguous Stripe outcome is converged, never duplicated — at most
# this many per run (default 25).
PAYMENT_REFUND_RECONCILIATION_MIN_AGE_MINUTES=5
PAYMENT_REFUND_RECONCILIATION_BATCH_SIZE=25

# Orphan provider-refund discovery (PAYMENT_PROVIDER=stripe only): payments
# with a refund still PENDING after this many minutes (default 60) get ONE
# bounded provider-side refund lookup per run (at most this many payments,
# default 25) to find Stripe refunds NovaAir never recorded. Discovery never
# creates refunds — unmatched provider refunds are flagged for investigation.
PAYMENT_ORPHAN_DISCOVERY_MIN_AGE_MINUTES=60
PAYMENT_ORPHAN_DISCOVERY_BATCH_SIZE=25

# Refund operational alerts (internal, log-based): a refund PENDING longer
# than this many minutes (default 60) counts as stuck; more than this many
# definitive refund rejections within one hour (default 5) is a spike.
PAYMENT_REFUND_ALERT_PENDING_MINUTES=60
PAYMENT_REFUND_ALERT_REJECTIONS_PER_HOUR=5

# Stripe (all required when PAYMENT_PROVIDER=stripe — TEST MODE keys for local
# development: sk_test_…/pk_test_…; the webhook secret comes from
# `stripe listen --forward-to http://localhost:3000/api/payments/webhook`).
# Real values belong only in your never-committed .env — placeholders stay empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is also the Angular environment's stripePublishableKey value.
STRIPE_PUBLISHABLE_KEY=

# Notification provider: 'mock' logs emails to the API console with link tokens
# redacted (development/test only — rejected when NODE_ENV=production); 'smtp' sends
# real email and REQUIRES all SMTP_* variables below plus MAIL_FROM. Any other
# value fails startup. In production, WEB_ORIGIN must also be set to the public
# web origin (localhost is rejected at startup).
NOTIFICATION_PROVIDER=mock

# Mail (all required when NOTIFICATION_PROVIDER=smtp; SMTP_PORT must be an
# integer between 1 and 65535)
MAIL_FROM="Airline Booking <no-reply@airline.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: Redis Pub/Sub for multi-instance dashboard real-time fan-out.
# Without it, dashboard WebSocket events work in-process (single API instance).
# REDIS_URL=redis://localhost:6379
